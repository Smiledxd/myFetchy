{
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "name": "myFetchy",
  "short_name": "myFetchy",
  "description": "Tus links, apuntes y archivos en un solo lugar.",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#2A4A8D",
